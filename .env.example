# IncidentLens — environment configuration

# Database
# Defaults to ./data/incidentlens.db
INCIDENTLENS_DB_PATH=./data/incidentlens.db

# Clanker Cloud (required for live investigations)
# Set to "live" to use the official Clanker Cloud Sandbox API
# Set to "demo" (default) for built-in deterministic fixtures
CLANKER_MODE=demo

# Optional: Override the Clanker Cloud base URL
# Default: https://clankercloud.ai
# CLANKER_API_URL=https://clankercloud.ai

# Optional: Investigation timeout in milliseconds
# Default: 120000 (2 minutes)
# CLANKER_TIMEOUT_MS=120000

# Demo mode settings (only used when CLANKER_MODE=demo)
CLANKER_DEMO_STEP_DELAY_MS=420

# Remediation plan approval TTL (default 1 hour)
APPROVAL_TTL_MS=3600000
