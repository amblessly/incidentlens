# IncidentLens — environment configuration
#
# Copy to .env.local (development) or set in your deployment environment.

# ---------------------------------------------------------------------------
# Application mode
# ---------------------------------------------------------------------------
# live (default): production mode. No demo fixtures, no simulated responses,
#                 no silent fallback to demo providers.
# demo:           explicit opt-in for development/tests/screenshots.
#                 Seeds deterministic fixtures and uses the DemoProvider.
INCIDENTLENS_MODE=live

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Session signing secret. REQUIRED in production — must be at least 32
# characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Defaults to ./data/incidentlens.db (SQLite for local dev)
# INCIDENTLENS_DB_PATH=./data/incidentlens.db
#
# For production/Vercel: use PostgreSQL (Neon)
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ---------------------------------------------------------------------------
# Infrastructure provider (Clanker Cloud) — required for live investigations
# ---------------------------------------------------------------------------
# Set to "live" to use the official Clanker Cloud Sandbox API.
# When not "live", live-mode investigations surface evidence as unavailable
# (never fabricated).
CLANKER_MODE=live

# MCP mode (recommended for hackathon) — connect to local Clanker CLI
# Start Clanker MCP server first: clanker mcp --transport http --listen 127.0.0.1:39393
# CLANKER_MCP_URL=http://127.0.0.1:39393
# CLANKER_MCP_TIMEOUT_MS=30000

# Base URL of the Clanker Cloud API (default https://clankercloud.ai)
# CLANKER_API_URL=https://clankercloud.ai

# Account API key (optional for anonymous sandboxes, required for
# account-owned sandboxes). Never expose to the browser.
# CLANKER_CLOUD_API_KEY=

# Optional persistent sandbox (created once, reused across investigations).
# When absent, an ephemeral sandbox is created per investigation and deleted
# afterwards.
# CLANKER_SANDBOX_ID=
# CLANKER_SANDBOX_TOKEN=

# Per-request timeout in milliseconds (default 120000)
# CLANKER_TIMEOUT_MS=120000

# Agent image to use when creating sandboxes (default clanker-cli)
# CLANKER_AGENT=clanker-cli

# Working directory for probe commands (default /workspace)
# CLANKER_WORKING_DIR=/workspace

# Read-only probe command (default incidentlens-probe). Must support the
# probe protocol documented in README.md.
# CLANKER_PROBE_TEST=
# CLANKER_PROBE_SERVICES=
# CLANKER_PROBE_HEALTH=
# CLANKER_PROBE_DEPLOYMENTS=
# CLANKER_PROBE_LOGS=
# CLANKER_PROBE_METRICS=
# CLANKER_PROBE_DATABASE=
# CLANKER_PROBE_CHANGES=

# ---------------------------------------------------------------------------
# Execution (remediation)
# ---------------------------------------------------------------------------
# Command that executes allow-listed operations inside the sandbox.
# Must accept: rollback --service X [--version V] | restart --service X |
# scale --service X --replicas N | check --service X --check NAME
CLANKER_EXEC_COMMAND=incidentlens-exec

# Remediation plan approval TTL (default 1 hour)
# APPROVAL_TTL_MS=3600000

# ---------------------------------------------------------------------------
# API hardening
# ---------------------------------------------------------------------------
# Max requests per key/IP per window (default 120 per minute)
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Demo mode only (IGNORED in live mode)
# ---------------------------------------------------------------------------
CLANKER_DEMO_STEP_DELAY_MS=420